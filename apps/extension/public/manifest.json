{
  "manifest_version": 3,
  "name": "Creator Intelligence AI",
  "version": "1.0.0",
  "description": "AI-powered YouTube creator intelligence: channel analytics, SEO, keyword research, competitor tracking and an AI growth assistant.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/dashboard/index.html",
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "identity", "sidePanel", "alarms", "notifications"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/panel.js", "content/panel.css", "assets/*", "icons/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
